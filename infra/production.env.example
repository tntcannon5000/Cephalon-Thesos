POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://thesos:URL_ENCODED_PASSWORD@postgres:5432/thesos
DBOS_SYSTEM_DATABASE_URL=postgresql://thesos:URL_ENCODED_PASSWORD@postgres:5432/thesos
OPENROUTER_API_KEY=replace-me
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODELS=["nvidia/nemotron-3-super-120b-a12b:free","openai/gpt-oss-120b:free"]

THESOS_API_IMAGE=ghcr.io/tntcannon5000/cephalon-thesos-api:replace-with-git-sha
THESOS_WEB_IMAGE=ghcr.io/tntcannon5000/cephalon-thesos-web:replace-with-git-sha
THESOS_BACKUP_IMAGE=ghcr.io/tntcannon5000/cephalon-thesos-backup:replace-with-git-sha
THESOS_SITE_ADDRESS=https://cephalonthesos.com

WORKER_CONCURRENCY=2
WORKER_LEASE_SECONDS=60
RUN_RETENTION_DAYS=30
BACKUP_RETENTION_DAYS=7
