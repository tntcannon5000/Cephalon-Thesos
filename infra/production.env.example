DATABASE_URL=postgresql+psycopg://thesos:URL_ENCODED_PASSWORD@postgres:5432/thesos
DBOS_SYSTEM_DATABASE_URL=postgresql://thesos:URL_ENCODED_PASSWORD@postgres:5432/thesos
SESSION_DIGEST_KEY=replace-with-an-independent-32-byte-or-longer-secret
IP_HMAC_KEY=replace-with-a-second-independent-32-byte-or-longer-secret
ADMIN_MFA_ENCRYPTION_KEY=replace-with-a-third-independent-32-byte-or-longer-secret
TRUSTED_PROXY_CIDRS=["172.16.0.0/12"]

EMAIL_FROM=Thesos Archives <accounts@mail.cephalonthesos.com>
RESEND_API_KEY=replace-me
TURNSTILE_SITE_KEY=replace-me
TURNSTILE_SECRET_KEY=replace-me
OPENROUTER_API_KEY=replace-me
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODELS=["nvidia/nemotron-3-super-120b-a12b:free","google/gemma-4-26b-a4b-it:free"]

THESOS_API_IMAGE=ghcr.io/tntcannon5000/cephalon-thesos-api:replace-with-git-sha
THESOS_WEB_IMAGE=ghcr.io/tntcannon5000/cephalon-thesos-web:replace-with-git-sha
