THESOS_ENV=development
THESOS_LOG_LEVEL=INFO
THESOS_API_HOST=127.0.0.1
THESOS_API_PORT=8000
THESOS_WEB_ORIGIN=http://127.0.0.1:5173
POSTGRES_PASSWORD=thesos-local-only

# Local alpha uses SQLite without requiring a system service. Production uses PostgreSQL.
DATABASE_URL=postgresql+psycopg://thesos:thesos-local-only@127.0.0.1:5432/thesos
DBOS_SYSTEM_DATABASE_URL=postgresql://thesos:thesos-local-only@127.0.0.1:5432/thesos
SESSION_COOKIE_SECURE=false
SESSION_DIGEST_KEY=thesos-development-session-key
IP_HMAC_KEY=thesos-development-ip-key
ADMIN_MFA_ENCRYPTION_KEY=thesos-development-mfa-key
TRUSTED_PROXY_CIDRS=["127.0.0.1/32","::1/128"]
PUBLIC_BASE_URL=http://127.0.0.1:5173
TERMS_VERSION=2026-08-17-private-alpha
EMAIL_DELIVERY=file
EMAIL_FROM=Thesos <archives@localhost>
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
BASE_DAILY_RUN_LIMIT=10
DEVICE_DAILY_RUN_LIMIT=10
IP_DAILY_RUN_LIMIT=10
GLOBAL_DAILY_RUN_LIMIT=100
MAX_USER_CONCURRENT_RUNS=2
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DBOS_DATABASE_POOL_SIZE=5
WORKER_CONCURRENCY=2
WORKER_POLL_SECONDS=0.5
WORKER_LEASE_SECONDS=60
WORKER_MAX_DISPATCH_ATTEMPTS=3
RUN_RETENTION_DAYS=30
RETENTION_POLL_SECONDS=3600

OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODELS=["nvidia/nemotron-3-super-120b-a12b:free","google/gemma-4-26b-a4b-it:free"]
OPENROUTER_ALLOW_PAID_MODELS=false
OPENROUTER_APP_URL=http://127.0.0.1:5173
OPENROUTER_APP_TITLE=Thesos Local Alpha
